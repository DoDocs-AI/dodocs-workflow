#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import re
import sys

_here = os.path.dirname(os.path.realpath(__file__))
for _cand in (_here, os.path.join(_here, "..", "lib")):
    if os.path.isdir(os.path.join(_cand, "dwlib")):
        sys.path.insert(0, os.path.normpath(_cand))
        break

from dwlib import agterm, runs, store  # noqa: E402


class UserError(Exception):
    pass


def slugify(name: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")


def cmd_project_add(args) -> int:
    pid = slugify(args.name)
    if not pid:
        raise UserError("project name must contain letters or digits")
    if not os.path.isdir(args.path):
        raise UserError("path is not a directory: %s" % args.path)
    project = {
        "id": pid,
        "name": args.name,
        "path": os.path.realpath(args.path),
        "group": args.group,
        "harness": "claude",
        "notes": args.notes,
        "guard_rules": [],
    }

    def add(reg):
        if any(p["id"] == pid for p in reg["projects"]):
            raise UserError("project already exists: %s" % pid)
        reg["projects"].append(project)
        return reg

    store.update_json(store.paths.registry_path(), add, store.default_registry())
    print("added %s" % pid)
    return 0


def cmd_project_list(args) -> int:
    projects = store.load_registry()["projects"]
    if args.json:
        print(json.dumps(projects, indent=2))
    else:
        for p in projects:
            print("%s\t%s\t%s\t%s" % (p["id"], p["group"], p["harness"], p["path"]))
    return 0


def cmd_project_remove(args) -> int:
    def remove(reg):
        kept = [p for p in reg["projects"] if p["id"] != args.id]
        if len(kept) == len(reg["projects"]):
            raise UserError("unknown project: %s" % args.id)
        reg["projects"] = kept
        return reg

    store.update_json(store.paths.registry_path(), remove, store.default_registry())
    print("removed %s" % args.id)
    return 0


def _find_project(query: str) -> dict:
    try:
        return store.find_project(store.load_registry(), query)
    except store.ProjectNotFound:
        raise UserError("unknown project: %s" % query)
    except store.AmbiguousProject as exc:
        raise UserError("ambiguous project %s: %s" % (query, ", ".join(c["id"] for c in exc.candidates)))


def cmd_run(args) -> int:
    command = list(args.command)
    if command[:1] == ["--"]:
        command = command[1:]
    if not command:
        raise UserError("usage: dw run PROJECT COMMAND...")
    project = _find_project(args.project)
    try:
        run = runs.request_run(project, " ".join(command))
    except runs.RunRefused as exc:
        raise UserError(str(exc))
    if run["state"] == "failed":
        sys.stderr.write("dw: %s failed: %s\n" % (run["id"], run.get("reason")))
        return 2
    if run["state"] == "queued" and run.get("reason") == "AGTerm unavailable":
        sys.stderr.write("dw: AGTerm did not respond; %s stays queued\n" % run["id"])
        return 2
    if run["state"] == "queued":
        print("%s queued (%s)" % (run["id"], run.get("reason") or "waiting"))
    else:
        print("%s started" % run["id"])
    return 0


def cmd_queue(args) -> int:
    queued = [r for r in store.list_runs()[0] if r.get("state") == "queued"]
    queued.sort(key=lambda r: (r.get("created_at") or 0, r["id"]))
    if args.json:
        print(json.dumps(queued, indent=2))
    else:
        for r in queued:
            print("%s\t%s\t%s\t%s" % (r["id"], r["project_id"], r.get("reason") or "",
                                       r["command"][:60].replace("\n", " ")))
    return 0


def cmd_cancel(args) -> int:
    try:
        run = runs.cancel_run(args.run_id)
    except runs.RunError as exc:
        raise UserError(str(exc))
    print("%s cancelled" % run["id"])
    return 0


class _Parser(argparse.ArgumentParser):
    def error(self, message):
        sys.stderr.write("dw: %s\n" % message.splitlines()[0])
        sys.exit(2)


def build_parser() -> argparse.ArgumentParser:
    parser = _Parser(prog="dw")
    sub = parser.add_subparsers(dest="command", parser_class=_Parser)
    sub.required = True
    project = sub.add_parser("project", help="manage the project registry")
    psub = project.add_subparsers(dest="action", parser_class=_Parser)
    psub.required = True
    add = psub.add_parser("add")
    add.add_argument("--name", required=True)
    add.add_argument("--path", required=True)
    add.add_argument("--group", required=True)
    add.add_argument("--notes", default="")
    add.set_defaults(func=cmd_project_add)
    lst = psub.add_parser("list")
    lst.add_argument("--json", action="store_true")
    lst.set_defaults(func=cmd_project_list)
    rm = psub.add_parser("remove")
    rm.add_argument("id")
    rm.set_defaults(func=cmd_project_remove)
    run = sub.add_parser("run", help="start a run in an AGTerm session")
    run.add_argument("project")
    run.add_argument("command", nargs=argparse.REMAINDER)
    run.set_defaults(func=cmd_run)
    queue = sub.add_parser("queue", help="list queued runs")
    queue.add_argument("--json", action="store_true")
    queue.set_defaults(func=cmd_queue)
    cancel = sub.add_parser("cancel", help="cancel a queued or running run")
    cancel.add_argument("run_id")
    cancel.set_defaults(func=cmd_cancel)
    return parser


def main(argv=None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.func(args)
    except UserError as exc:
        sys.stderr.write("dw: %s\n" % exc)
        return 2
    except agterm.AgtermUnavailable as exc:
        sys.stderr.write("dw: AGTerm is not reachable: %s\n" % exc)
        return 2
    except agterm.AgtermError as exc:
        sys.stderr.write("dw: AGTerm call failed: %s\n" % (str(exc).splitlines() or ["error"])[0])
        return 2
    except store.CorruptFile as exc:
        sys.stderr.write("dw: corrupt file: %s\n" % exc.path)
        return 2


if __name__ == "__main__":
    sys.exit(main())
