{
  "version": 1,
  "comment": "Default guard rules. Bash rules: program (basenames), subcommand (word sequences, glob words, starting within the first `within` non-option words, default 3), unless_subcommand, args_any, check (a named check in guard.py). MCP rules: server, server_contains, unless_server (globs), names, verbs (write | write_or_unknown | send | spend). The first matching rule per command segment wins. Control rules (dw, the control point's files, unreadable commands, other agent CLIs) are built into guard.py and always apply.",
  "rules": [
    {"id": "git-push-default", "category": "merge", "describe": "push to the default branch", "tool": "Bash", "program": ["git"], "check": "git_push_default_branch"},
    {"id": "git-push-tags", "category": "publish", "describe": "push tags", "tool": "Bash", "program": ["git"], "check": "git_push_tags"},
    {"id": "git-merge-default", "category": "merge", "describe": "merge into the default branch", "tool": "Bash", "program": ["git"], "check": "git_merge_default_branch"},
    {"id": "gh-pr-merge", "category": "merge", "describe": "merge a pull request", "tool": "Bash", "program": ["gh"], "subcommand": ["pr merge"]},
    {"id": "glab-mr-merge", "category": "merge", "describe": "merge a merge request", "tool": "Bash", "program": ["glab"], "subcommand": ["mr merge"]},
    {"id": "gh-repo-delete", "category": "destroy", "describe": "delete a GitHub repository", "tool": "Bash", "program": ["gh"], "subcommand": ["repo delete", "repo archive", "release delete"]},
    {"id": "gh-release", "category": "publish", "describe": "publish on GitHub", "tool": "Bash", "program": ["gh"], "subcommand": ["release create", "release upload", "release edit", "repo create", "repo edit", "repo rename", "gist create"]},
    {"id": "gh-actions", "category": "deploy", "describe": "change GitHub Actions or secrets", "tool": "Bash", "program": ["gh"], "subcommand": ["secret set", "secret delete", "variable set", "variable delete", "workflow run", "workflow enable", "workflow disable", "run rerun"]},
    {"id": "gh-api-write", "category": "publish", "describe": "write through the GitHub API", "tool": "Bash", "program": ["gh"], "check": "gh_api_write"},

    {"id": "kubectl-delete", "category": "destroy", "describe": "delete Kubernetes resources", "tool": "Bash", "program": ["kubectl", "oc", "k"], "subcommand": ["delete"]},
    {"id": "kubectl-change", "category": "deploy", "describe": "change a Kubernetes cluster", "tool": "Bash", "program": ["kubectl", "oc", "k"], "subcommand": ["apply", "create", "replace", "patch", "rollout", "scale", "set", "edit", "label", "annotate", "expose", "run", "drain", "cordon", "uncordon", "taint", "autoscale"]},
    {"id": "helm-change", "category": "deploy", "describe": "change a Helm release", "tool": "Bash", "program": ["helm"], "subcommand": ["install", "upgrade", "uninstall", "delete", "rollback", "push"]},
    {"id": "docker-push", "category": "deploy", "describe": "push a container image", "tool": "Bash", "program": ["docker", "podman", "nerdctl"], "subcommand": ["push", "image push", "manifest push", "compose push", "buildx imagetools create"]},
    {"id": "docker-build-push", "category": "deploy", "describe": "build and push a container image", "tool": "Bash", "program": ["docker", "podman"], "subcommand": ["build", "buildx build", "buildx bake", "compose build", "compose up"], "args_any": ["--push"]},
    {"id": "docker-volume-destroy", "category": "destroy", "describe": "delete Docker volumes or data", "tool": "Bash", "program": ["docker", "podman"], "subcommand": ["volume rm", "volume prune", "system prune"]},
    {"id": "registry-push", "category": "deploy", "describe": "change a container registry", "tool": "Bash", "program": ["skopeo", "crane", "ko", "regctl"], "subcommand": ["copy", "delete", "sync", "push", "append", "mutate", "tag", "apply", "publish", "build", "resolve", "image"]},
    {"id": "vercel-deploy", "category": "deploy", "describe": "deploy with Vercel", "tool": "Bash", "program": ["vercel", "vc"], "unless_subcommand": ["ls", "list", "inspect", "logs", "whoami", "login", "logout", "help", "link", "pull", "dev", "build", "switch", "teams", "projects"]},
    {"id": "netlify-deploy", "category": "deploy", "describe": "deploy with Netlify", "tool": "Bash", "program": ["netlify", "ntl"], "subcommand": ["deploy", "env:set", "env:unset", "sites:delete", "sites:create"]},
    {"id": "firebase-deploy", "category": "deploy", "describe": "change a Firebase project", "tool": "Bash", "program": ["firebase"], "subcommand": ["deploy", "hosting:*", "functions:delete", "firestore:delete", "database:remove", "database:set", "database:update", "database:push", "auth:import"]},
    {"id": "fly-deploy", "category": "deploy", "describe": "change a Fly.io app", "tool": "Bash", "program": ["fly", "flyctl"], "subcommand": ["deploy", "launch", "destroy", "apps", "scale", "secrets", "machine", "machines", "volumes", "postgres", "ips", "certs"]},
    {"id": "wrangler-deploy", "category": "deploy", "describe": "change Cloudflare", "tool": "Bash", "program": ["wrangler"], "subcommand": ["deploy", "publish", "secret", "rollback", "delete", "pages deploy", "pages publish", "kv:*", "kv", "r2", "d1 execute", "versions deploy"]},
    {"id": "railway-deploy", "category": "deploy", "describe": "change a Railway project", "tool": "Bash", "program": ["railway"], "subcommand": ["up", "deploy", "redeploy", "down", "delete", "variables"]},
    {"id": "heroku-change", "category": "deploy", "describe": "change a Heroku app", "tool": "Bash", "program": ["heroku"], "subcommand": ["create", "destroy", "*:set", "*:unset", "*:destroy", "*:reset", "*:rollback", "*:scale", "*:restart", "*:promote", "*:create", "*:add", "*:remove", "*:attach", "*:detach"], "within": 1},
    {"id": "gcloud-change", "category": "deploy", "describe": "change Google Cloud", "tool": "Bash", "program": ["gcloud"], "subcommand": ["deploy", "create", "delete", "update", "apply", "patch", "add-iam-policy-binding", "remove-iam-policy-binding", "set-iam-policy", "start", "stop", "reset", "resize", "rollback", "import", "submit", "promote", "upload", "cp", "rm", "mv", "rsync", "scp", "ssh"], "within": 6},
    {"id": "gsutil-change", "category": "deploy", "describe": "change Google Cloud Storage", "tool": "Bash", "program": ["gsutil"], "subcommand": ["cp", "mv", "rm", "rsync", "rb", "mb", "setmeta", "acl", "iam", "defacl"], "within": 1},
    {"id": "aws-change", "category": "deploy", "describe": "change AWS", "tool": "Bash", "program": ["aws"], "subcommand": ["create-*", "delete-*", "put-*", "update-*", "deploy", "run-instances", "terminate-*", "start-*", "stop-*", "reboot-*", "invoke", "publish", "send-*", "cp", "mv", "rm", "sync", "rb", "mb", "attach-*", "detach-*", "modify-*", "register-*", "deregister-*", "tag-resource", "untag-resource", "set-*", "apply-*", "import-*", "restore-*", "promote-*", "execute-*", "batch-write-item", "write-*", "upload-*", "purchase-*", "subscribe", "add-*", "remove-*", "authorize-*", "revoke-*", "associate-*", "disassociate-*", "enable-*", "disable-*", "reset-*", "cancel-*", "invalidate-*"], "within": 4},
    {"id": "az-change", "category": "deploy", "describe": "change Azure", "tool": "Bash", "program": ["az", "azd"], "subcommand": ["create", "delete", "update", "deploy", "set", "start", "stop", "restart", "up", "down", "apply", "add", "remove", "upload", "purge", "import", "swap", "scale", "provision"], "within": 5},
    {"id": "doctl-change", "category": "deploy", "describe": "change DigitalOcean", "tool": "Bash", "program": ["doctl"], "subcommand": ["create", "delete", "update", "deploy", "apply", "resize", "power-off", "power-on", "rebuild"], "within": 4},
    {"id": "terraform-destroy", "category": "destroy", "describe": "destroy infrastructure", "tool": "Bash", "program": ["terraform", "tofu", "terragrunt", "pulumi", "cdk", "cdktf"], "subcommand": ["destroy", "state rm", "workspace delete", "stack rm"]},
    {"id": "terraform-apply", "category": "deploy", "describe": "change infrastructure", "tool": "Bash", "program": ["terraform", "tofu", "terragrunt"], "subcommand": ["apply", "import", "taint", "untaint", "state mv", "state push", "force-unlock", "run-all"]},
    {"id": "pulumi-up", "category": "deploy", "describe": "change infrastructure", "tool": "Bash", "program": ["pulumi", "cdk", "cdktf", "serverless", "sls", "sam"], "subcommand": ["up", "update", "import", "cancel", "refresh", "deploy", "bootstrap", "remove", "rollback", "delete", "sync"]},
    {"id": "cluster-tools", "category": "deploy", "describe": "change a cluster or deployment", "tool": "Bash", "program": ["eksctl", "argocd", "skaffold", "kamal", "cap", "mina"] , "subcommand": ["create", "delete", "upgrade", "scale", "drain", "set", "unset", "update", "app sync", "app create", "app delete", "app rollback", "app set", "app patch", "app actions", "run", "deploy", "dev", "apply", "setup", "rollback", "redeploy", "remove", "deploy:*"]},
    {"id": "ansible", "category": "deploy", "describe": "run Ansible against hosts", "tool": "Bash", "program": ["ansible", "ansible-playbook", "ansible-pull"]},
    {"id": "remote-shell", "category": "deploy", "describe": "run commands on a remote host", "tool": "Bash", "program": ["ssh", "mosh", "autossh"]},
    {"id": "remote-copy", "category": "deploy", "describe": "copy files to a remote host", "tool": "Bash", "program": ["scp", "rsync", "sftp"], "check": "remote_copy"},

    {"id": "package-publish", "category": "publish", "describe": "publish a package", "tool": "Bash", "program": ["npm", "pnpm", "yarn", "bun"], "subcommand": ["publish", "unpublish", "deprecate", "dist-tag add", "dist-tag rm", "owner add", "owner rm", "access"], "within": 1},
    {"id": "package-publish-other", "category": "publish", "describe": "publish a package", "tool": "Bash", "program": ["twine", "cargo", "gem", "poetry", "uv", "hatch", "flit", "pdm", "rye", "vsce", "ovsx", "lerna", "changeset", "pod", "dotnet", "goreleaser", "jreleaser"], "subcommand": ["upload", "register", "publish", "yank", "push", "owner", "trunk push", "nuget push", "release", "full-release", "deploy"], "within": 2},
    {"id": "build-tool-deploy", "category": "publish", "describe": "deploy or publish a build", "tool": "Bash", "program": ["mvn", "mvnw", "gradle", "gradlew", "sbt", "lein"], "subcommand": ["deploy", "deploy:*", "jib:build", "release:perform", "publish", "publish*", "jib", "release", "publishSigned"], "within": 8},
    {"id": "semantic-release", "category": "publish", "describe": "publish a release", "tool": "Bash", "program": ["semantic-release", "release-it", "np"]},

    {"id": "shell-mail", "category": "send", "describe": "send email", "tool": "Bash", "program": ["sendmail", "mail", "mailx", "mutt", "neomutt", "msmtp", "swaks", "ssmtp"]},
    {"id": "curl-mail", "category": "send", "describe": "send email", "tool": "Bash", "program": ["curl"], "check": "curl_mail"},
    {"id": "osascript", "category": "send", "describe": "run AppleScript (can send messages or mail)", "tool": "Bash", "program": ["osascript"]},
    {"id": "stripe-cli-write", "category": "spend", "describe": "write to Stripe", "tool": "Bash", "program": ["stripe"], "subcommand": ["create", "update", "delete", "post", "capture", "pay", "refund", "cancel", "void", "finalize", "send", "trigger", "fixtures"]},

    {"id": "sql-destructive", "category": "destroy", "describe": "destructive database command", "tool": "Bash", "check": "sql_destructive"},
    {"id": "db-drop-tools", "category": "destroy", "describe": "destructive database command", "tool": "Bash", "program": ["dropdb", "dropuser"]},
    {"id": "db-reset", "category": "destroy", "describe": "reset a database", "tool": "Bash", "program": ["prisma", "rails", "rake", "bin/rails", "django-admin", "python", "python3", "drizzle-kit", "sequelize", "knex", "typeorm"], "subcommand": ["migrate reset", "db:drop", "db:reset", "db:schema:load", "db:purge", "db:truncate_all", "flush", "manage.py flush", "manage.py reset_db", "db:drop:all", "drop", "schema:drop"], "within": 2},
    {"id": "db-force-push", "category": "destroy", "describe": "reset a database", "tool": "Bash", "program": ["prisma", "drizzle-kit"], "args_any": ["--force-reset", "--accept-data-loss", "--force"]},
    {"id": "delete-outside-project", "category": "destroy", "describe": "delete files outside the project", "tool": "Bash", "check": "rm_outside_project"},

    {"id": "network-write", "category": "publish", "describe": "send data to a remote host", "tool": "Bash", "program": ["curl", "wget", "http", "https", "xh", "xhs", "httpie"], "check": "http_write_remote"},
    {"id": "raw-network", "category": "publish", "describe": "open a raw network connection", "tool": "Bash", "program": ["nc", "ncat", "netcat", "socat", "telnet"], "check": "raw_network"},

    {"id": "mcp-mail-send", "category": "send", "describe": "send email", "tool": "mcp", "server_contains": ["gmail", "mail", "outlook"], "names": ["send_message", "reply", "forward", "send_draft", "sendMailDraft"]},
    {"id": "mcp-payments", "category": "spend", "describe": "write to a payment or ads service", "tool": "mcp", "server_contains": ["stripe", "paypal", "square", "braintree", "adyen", "paddle", "lemonsqueezy", "chargebee", "ads", "adwords", "runpod"], "verbs": "write_or_unknown"},
    {"id": "mcp-spend", "category": "spend", "describe": "spend money", "tool": "mcp", "verbs": "spend", "unless_server": ["linear", "claude_ai_atlassian", "plugin_context7_context7"]},
    {"id": "mcp-send", "category": "send", "describe": "send a message", "tool": "mcp", "verbs": "send", "unless_server": ["linear", "claude_ai_atlassian", "plugin_context7_context7"]},
    {"id": "mcp-calendar-write", "category": "send", "describe": "change a calendar (may send invitations)", "tool": "mcp", "server_contains": ["calendar"], "verbs": "write"},
    {"id": "mcp-external-write", "category": "publish", "describe": "write to an outside service", "tool": "mcp", "verbs": "write_or_unknown", "unless_server": ["linear", "claude_ai_atlassian", "plugin_context7_context7"]}
  ]
}
